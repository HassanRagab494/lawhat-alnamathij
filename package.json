{
  "name": "lawhat-alnamathij",
  "private": true,
  "version": "0.1.0",
  "description": "لوحة النماذج — المرحلة الأولى: الأساس، الدخول، المستخدمون والصلاحيات، إدارة النماذج الأساسية",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @lawha/api",
    "db:migrate:dev": "dotenv -e .env -- npm run db:migrate:dev -w @lawha/api",
    "admin:create": "dotenv -e .env -- npm run admin:create -w @lawha/api --",
    "dev:api": "dotenv -e .env -- npm run dev -w @lawha/api",
    "dev:web": "dotenv -e .env -- npm run dev -w @lawha/web",
    "build": "npm run build -w @lawha/api && dotenv -e .env.example -- npm run build -w @lawha/web",
    "start:api": "dotenv -e .env -- npm run start -w @lawha/api",
    "start:web": "dotenv -e .env -- npm run start -w @lawha/web",
    "typecheck": "npm run typecheck -w @lawha/api && npm run typecheck -w @lawha/web",
    "test": "npm run test -w @lawha/api && npm run test -w @lawha/web",
    "test:e2e": "dotenv -e .env -- npm run test:e2e -w @lawha/api",
    "openapi:export": "npm run openapi:export -w @lawha/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "postcss": "8.5.29",
    "js-yaml@^5.3.0": "5.4.3",
    "deepmerge-ts": "7.1.6"
  }
}
