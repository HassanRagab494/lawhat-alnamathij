+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\FormsIntegration\Controllers;
+
+use App\Http\Controllers\Controller;
+use App\Models\IntegrationIntake;
+use App\Modules\FormsIntegration\Services\FormsIntegrationService;
+use App\Modules\Properties\Requests\StorePropertyRequest;
+use App\Modules\PropertyDemands\Requests\StoreAdminPropertyDemandRequest;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\Validator;
+
+/**
+ * Idempotent endpoints for the forms platform integration account
+ * (admin permission integrations.forms). The payload rules are the same
+ * rules used by the admin property and demand endpoints.
+ */
+final class FormsIntegrationController extends Controller
+{
+    private const SOURCE_KEY_RULES = ['required', 'string', 'min:8', 'max:191', 'regex:/^[A-Za-z0-9:._-]+$/'];
+
+    public function __construct(private readonly FormsIntegrationService $integration) {}
+
+    /** POST /api/admin/integrations/forms/offers */
+    public function storeOffer(Request $request): JsonResponse
+    {
+        $rules = StorePropertyRequest::createFrom($request)->rules();
+        $validated = Validator::make($request->all(), ['source_key' => self::SOURCE_KEY_RULES, ...$rules])->validate();
+
+        $result = $this->integration->createOffer(
+            $request->user(),
+            $validated['source_key'],
+            Arr::except($validated, ['source_key']),
+        );
+
+        return $this->respond($result);
+    }
+
+    /** POST /api/admin/integrations/forms/demands */
+    public function storeDemand(Request $request): JsonResponse
+    {
+        if (is_string($request->input('requester_phone'))) {
+            $request->merge(['requester_phone' => trim($request->input('requester_phone'))]);
+        }
+        $rules = Arr::except(StoreAdminPropertyDemandRequest::createFrom($request)->rules(), ['idempotency_key']);
+        $validated = Validator::make($request->all(), [
+            'source_key' => self::SOURCE_KEY_RULES,
+            'idempotency_key' => ['prohibited'],
+            ...$rules,
+        ])->validate();
+
+        $result = $this->integration->createDemand(
+            $request->user(),
+            $validated['source_key'],
+            Arr::except($validated, ['source_key']),
+        );
+
+        return $this->respond($result);
+    }
+
+    /** POST /api/admin/integrations/forms/offers/{sourceKey}/media */
+    public function storeMedia(Request $request, string $sourceKey): JsonResponse
+    {
+        $validated = $request->validate([
+            'media_key' => self::SOURCE_KEY_RULES,
+            'kind' => ['required', 'in:image,video'],
+            'file' => ['required', 'file'],
+        ]);
+        $offer = $this->integration->find($request->user(), $sourceKey);
+        abort_if($offer === null, 404);
+
+        $result = $this->integration->attachMedia(
+            $request->user(),
+            $offer,
+            $validated['media_key'],
+            $validated['kind'],
+            $request->file('file'),
+        );
+
+        return response()->json(
+            ['success' => true, 'data' => $this->integration->record($result['intake'], $result['replayed'])],
+            $result['replayed'] ? 200 : 201,
+        );
+    }
+
+    /** POST /api/admin/integrations/forms/offers/{sourceKey}/publish */
+    public function publishOffer(Request $request, string $sourceKey): JsonResponse
+    {
+        $offer = $this->integration->find($request->user(), $sourceKey);
+        abort_if($offer === null, 404);
+        $this->integration->publishOffer($offer);
+
+        return response()->json(['success' => true, 'data' => $this->integration->record($offer)]);
+    }
+
+    /** GET /api/admin/integrations/forms/records/{sourceKey} */
+    public function show(Request $request, string $sourceKey): JsonResponse
+    {
+        $record = $this->integration->find($request->user(), $sourceKey);
+        abort_if($record === null, 404);
+
+        return response()->json(['success' => true, 'data' => $this->integration->record($record)]);
+    }
+
+    /** @param array{intake: IntegrationIntake, replayed: bool} $result */
+    private function respond(array $result): JsonResponse
+    {
+        return response()->json(
+            ['success' => true, 'data' => $this->integration->record($result['intake'], $result['replayed'])],
+            $result['replayed'] ? 200 : 201,
+        );
+    }
+}
diff --git a/backend/app/Modules/FormsIntegration/Services/FormsIntegrationService.php b/backend/app/Modules/FormsIntegration/Services/FormsIntegrationService.php
new file mode 100644
index 0000000..14e05f9
--- /dev/null
+++ b/backend/app/Modules/FormsIntegration/Services/FormsIntegrationService.php
@@ -0,0 +1,257 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Modules\FormsIntegration\Services;
+
+use App\Exceptions\FlowmaxRuleException;
+use App\Models\IntegrationIntake;
+use App\Models\Property;
+use App\Models\PropertyDemand;
+use App\Models\User;
+use App\Modules\Properties\Services\PropertyCatalogService;
+use App\Modules\Properties\Services\PropertyFieldDefinitionService;
+use App\Modules\Properties\Services\PropertyService;
+use App\Modules\Properties\Services\PropertyVideoService;
+use App\Modules\PropertyDemands\Services\PropertyDemandService;
+use Closure;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Idempotent intake for the forms platform. Every write is keyed by
+ * (integration user, source_key) under a database unique constraint:
+ * a retry or a concurrent duplicate returns the original record, and the
+ * same key with different content is rejected with 409. Records are created
+ * through the existing property/demand services, so their validation and
+ * publication rules still apply.
+ */
+final class FormsIntegrationService
+{
+    public const OFFER = 'offer';
+
+    public const DEMAND = 'demand';
+
+    public const IMAGE = 'offer_image';
+
+    public const VIDEO = 'offer_video';
+
+    private const CLAIM_ATTEMPTS = 10;
+
+    public function __construct(
+        private readonly PropertyService $properties,
+        private readonly PropertyVideoService $videos,
+        private readonly PropertyFieldDefinitionService $propertyFields,
+        private readonly PropertyCatalogService $catalog,
+        private readonly PropertyDemandService $demands,
+    ) {}
+
+    /**
+     * @param  array<string, mixed>  $payload  validated property payload
+     * @return array{intake: IntegrationIntake, replayed: bool}
+     */
+    public function createOffer(User $actor, string $sourceKey, array $payload): array
+    {
+        return $this->claim($actor, $sourceKey, self::OFFER, $this->hash($payload), null, function () use ($payload, $actor): array {
+            $property = $this->properties->create($payload);
+            $this->propertyFields->replaceValues($property, $payload['custom_attributes'] ?? [], $actor);
+
+            return ['property', $property->id];
+        });
+    }
+
+    /**
+     * @param  array<string, mixed>  $payload  validated demand payload (without idempotency_key)
+     * @return array{intake: IntegrationIntake, replayed: bool}
+     */
+    public function createDemand(User $actor, string $sourceKey, array $payload): array
+    {
+        return $this->claim($actor, $sourceKey, self::DEMAND, $this->hash($payload), null, function () use ($payload, $actor, $sourceKey): array {
+            $demand = $this->demands->createFromAdminIntake([
+                ...$payload,
+                // The demand service keeps its own idempotency; derive a stable key from the source key.
+                'idempotency_key' => 'forms-'.hash('sha256', $actor->id.'|'.$sourceKey),
+            ], $actor);
+
+            return ['property_demand', $demand->id];
+        });
+    }
+
+    /**
+     * Attach one media file to an offer. Each attachment has its own key, so a
+     * lost response followed by a retry never stores the file twice.
+     *
+     * @return array{intake: IntegrationIntake, replayed: bool}
+     */
+    public function attachMedia(User $actor, IntegrationIntake $offer, string $mediaKey, string $kind, UploadedFile $file): array
+    {
+        $property = $this->offerProperty($offer);
+        $operation = $kind === 'video' ? self::VIDEO : self::IMAGE;
+        $hash = $this->hash([
+            'offer' => $offer->id,
+            'kind' => $kind,
+            'sha256' => hash_file('sha256', (string) $file->getRealPath()),
+        ]);
+
+        return $this->claim($actor, $mediaKey, $operation, $hash, $offer->id, function () use ($property, $kind, $file): array {
+            if ($kind === 'video') {
+                $video = $this->videos->upload($property, $file);
+
+                return ['property_video', $video->id];
+            }
+            $image = $this->properties->uploadImage($property, $file);
+
+            return ['property_image', $image->id];
+        });
+    }
+
+    /** Publish through the standard publication rules; publishing twice is a no-op. */
+    public function publishOffer(IntegrationIntake $offer): Property
+    {
+        $property = $this->offerProperty($offer);
+        if ($property->status === 'Published') {
+            return $property;
+        }
+
+        return $this->properties->publish($property);
+    }
+
+    public function find(User $actor, string $sourceKey): ?IntegrationIntake
+    {
+        return IntegrationIntake::query()
+            ->where('integration_user_id', $actor->id)
+            ->where('source_key', $sourceKey)
+            ->whereNotNull('target_id')
+            ->first();
+    }
+
+    /**
+     * Public projection of an offer or demand: identifiers, status and the
+     * detail URL. Contact and internal fields are never included.
+     *
+     * @return array<string, mixed>
+     */
+    public function record(IntegrationIntake $intake, bool $replayed = false): array
+    {
+        $base = rtrim((string) config('app.frontend_url'), '/');
+
+        if ($intake->operation === self::OFFER) {
+            $property = Property::query()->withCount(['images', 'videos'])->findOrFail($intake->target_id);
+            $isPublic = $property->status === 'Published' && $this->catalog->isVisible($property);
+
+            return [
+                'source_key' => $intake->source_key,
+                'operation' => self::OFFER,
+                'id' => $property->id,
+                'reference' => $property->property_code,
+                'status' => $property->status,
+                'is_public' => $isPublic,
+                // Detail page route of the Flowmax website: frontend/website/app/property/[id]
+                'detail_url' => $base.'/property/'.$property->id,
+                'images_count' => $property->images_count,
+                'videos_count' => $property->videos_count,
+                'replayed' => $replayed,
+            ];
+        }
+
+        if ($intake->operation === self::DEMAND) {
+            $demand = PropertyDemand::query()->findOrFail($intake->target_id);
+            $isPublic = $this->demands->publicQuery()->whereKey($demand->id)->exists();
+
+            return [
+                'source_key' => $intake->source_key,
+                'operation' => self::DEMAND,
+                'id' => $demand->id,
+                'reference' => $demand->public_reference,
+                'status' => $demand->status,
+                'is_public' => $isPublic,
+                // Detail page route of the Flowmax website: frontend/website/app/properties/demands/[reference]
+                'detail_url' => $base.'/properties/demands/'.$demand->public_reference,
+                'replayed' => $replayed,
+            ];
+        }
+
+        return [
+            'media_key' => $intake->source_key,
+            'operation' => $intake->operation,
+            'id' => $intake->target_id,
+            'replayed' => $replayed,
+        ];
+    }
+
+    private function offerProperty(IntegrationIntake $offer): Property
+    {
+        if ($offer->operation !== self::OFFER) {
+            throw new FlowmaxRuleException('integration_record_not_offer', 'The source record is not a property offer.', 422);
+        }
+
+        return Property::query()->findOrFail($offer->target_id);
+    }
+
+    /**
+     * Claim the key, then create the record in the same transaction. The
+     * unique index serialises concurrent requests for one key: the second
+     * waits for the first to commit and then replays its result. A lock
+     * conflict (MySQL deadlock between the duplicate-key check and the row
+     * lock) rolls back and retries the whole claim.
+     *
+     * @param  Closure(): array{0: string, 1: int}  $create
+     * @return array{intake: IntegrationIntake, replayed: bool}
+     */
+    private function claim(User $actor, string $sourceKey, string $operation, string $hash, ?int $parentId, Closure $create): array
+    {
+        return DB::transaction(function () use ($actor, $sourceKey, $operation, $hash, $parentId, $create): array {
+            $now = now();
+            DB::table('integration_intakes')->insertOrIgnore([
+                'integration_user_id' => $actor->id,
+                'source_key' => $sourceKey,
+                'operation' => $operation,
+                'request_hash' => $hash,
+                'parent_intake_id' => $parentId,
+                'created_at' => $now,
+                'updated_at' => $now,
+            ]);
+
+            $intake = IntegrationIntake::query()
+                ->where('integration_user_id', $actor->id)
+                ->where('source_key', $sourceKey)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if ($intake->operation !== $operation || ! hash_equals($intake->request_hash, $hash)) {
+                throw new FlowmaxRuleException(
+                    'integration_key_conflict',
+                    'This source key was already used with different content.',
+                    409,
+                );
+            }
+
+            if ($intake->target_id !== null) {
+                return ['intake' => $intake, 'replayed' => true];
+            }
+
+            [$type, $id] = $create();
+            $intake->forceFill(['target_type' => $type, 'target_id' => $id])->save();
+
+            return ['intake' => $intake, 'replayed' => false];
+        }, self::CLAIM_ATTEMPTS);
+    }
+
+    /** @param array<string, mixed> $payload */
+    private function hash(array $payload): string
+    {
+        return hash('sha256', json_encode($this->canonical($payload), JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE));
+    }
+
+    private function canonical(mixed $value): mixed
+    {
+        if (! is_array($value)) {
+            return $value;
+        }
+        if (! array_is_list($value)) {
+            ksort($value);
+        }
+
+        return array_map(fn ($item) => $this->canonical($item), $value);
+    }
+}
