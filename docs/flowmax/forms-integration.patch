+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Ledger for external integrations (the forms platform). The unique
+ * (integration_user_id, source_key) pair guarantees that one source record
+ * maps to exactly one Flowmax record, across retries and concurrent requests.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('integration_intakes', function (Blueprint $table): void {
+            $table->id();
+            $table->foreignId('integration_user_id')->constrained('users')->restrictOnDelete();
+            $table->string('source_key', 191);
+            $table->string('operation', 32);
+            $table->char('request_hash', 64);
+            $table->string('target_type', 32)->nullable();
+            $table->unsignedBigInteger('target_id')->nullable();
+            $table->unsignedBigInteger('parent_intake_id')->nullable();
+            $table->timestamps();
+
+            $table->unique(['integration_user_id', 'source_key']);
+            $table->index(['target_type', 'target_id']);
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('integration_intakes');
+    }
+};
