+<?php
+
+declare(strict_types=1);
+
+// Separate PHP process used by FormsIntegrationConcurrencyTest: waits for a
+// shared start time, then claims the same source key as its siblings.
+
+use App\Models\User;
+use App\Modules\FormsIntegration\Services\FormsIntegrationService;
+use Illuminate\Contracts\Console\Kernel;
+
+require __DIR__.'/../../vendor/autoload.php';
+$app = require __DIR__.'/../../bootstrap/app.php';
+$app->make(Kernel::class)->bootstrap();
+
+[, $userId, $developerId, $sourceKey, $startAt] = $argv;
+
+while (microtime(true) < (float) $startAt) {
+    usleep(500);
+}
+
+try {
+    $result = app(FormsIntegrationService::class)->createOffer(User::query()->findOrFail((int) $userId), $sourceKey, [
+        'title_ar' => 'عقار اختبار التزامن',
+        'description_ar' => 'وصف',
+        'type_letter' => 'M',
+        'developer_id' => (int) $developerId,
+        'mediation_contract_number' => 'MCN-CONCURRENCY',
+        'contract_day' => '15',
+        'contract_month' => '03',
+        'fal_license_number' => 'FAL-CONCURRENCY',
+        'listing_purpose' => 'sale',
+        'requested_price' => 1_000_000,
+        'city' => 'الرياض',
+        'district' => 'النرجس',
+    ]);
+    echo json_encode(['id' => $result['intake']->target_id, 'replayed' => $result['replayed']]);
+} catch (Throwable $e) {
+    echo json_encode(['error' => $e::class.': '.$e->getMessage()]);
