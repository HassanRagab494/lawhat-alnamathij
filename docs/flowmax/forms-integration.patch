+<?php
+
+declare(strict_types=1);
+
+use App\Models\Developer;
+use App\Models\IntegrationIntake;
+use App\Models\Property;
+use App\Models\PropertyDemand;
+use App\Models\PropertyImage;
+use App\Models\PropertyVideo;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+
+uses(RefreshDatabase::class);
+
+function formsIntegrationUser(): User
+{
+    return User::factory()->create([
+        'role' => 'admin',
+        'status' => 'active',
+        'admin_permissions' => ['integrations.forms'],
+    ]);
+}
+
+function formsOfferPayload(int $developerId, array $overrides = []): array
+{
+    return [
+        'source_key' => 'lawha:response:0001',
+        'title_ar' => 'شقة مطلة على الحديقة',
+        'description_ar' => 'ثلاث غرف وصالة',
+        'type_letter' => 'M',
+        'property_category' => 'apartment',
+        'listing_purpose' => 'sale',
+        'developer_id' => $developerId,
+        'mediation_contract_number' => 'MCN-TEST',
+        'contract_day' => '15',
+        'contract_month' => '03',
+        'fal_license_number' => 'FAL-TEST',
+        'requested_price' => 85_000_000,
+        'city' => 'الرياض',
+        'district' => 'النرجس',
+        'contact_phone' => '+966551234567',
+        'listing_notes' => 'اسم المالك: سارة',
+        ...$overrides,
+    ];
+}
+
+function formsDemandPayload(array $overrides = []): array
+{
+    return [
+        'source_key' => 'lawha:response:demand-0001',
+        'requester_name' => 'سارة المالكة',
+        'requester_phone' => '+966551234567',
+        'property_category' => 'apartment',
+        'listing_purpose' => 'rent',
+        'city' => 'الرياض',
+        'budget_max_halalas' => 6_000_000,
+        'consent_version' => 'forms-2026-10',
+        'intake_consent_evidence' => 'Consent recorded in forms response K7Q2',
+        ...$overrides,
+    ];
+}
+
+beforeEach(function (): void {
+    Storage::fake('local');
+    config(['app.frontend_url' => 'https://flowmax.test']);
+    $this->integration = formsIntegrationUser();
+    $this->developer = Developer::factory()->create();
+});
+
+it('creates one draft offer per source key and replays it on retry', function (): void {
+    $payload = formsOfferPayload($this->developer->id);
+
+    $first = $this->actingAs($this->integration)->postJson('/api/admin/integrations/forms/offers', $payload)
+        ->assertCreated()
+        ->assertJsonPath('data.operation', 'offer')
+        ->assertJsonPath('data.status', 'Draft')
+        ->assertJsonPath('data.is_public', false)
+        ->assertJsonPath('data.replayed', false);
+
+    // Same request again (e.g. the first response was lost): same record, no new property.
+    $this->actingAs($this->integration)->postJson('/api/admin/integrations/forms/offers', $payload)
+        ->assertOk()
+        ->assertJsonPath('data.id', $first->json('data.id'))
+        ->assertJsonPath('data.replayed', true);
+
+    expect(Property::query()->count())->toBe(1)
+        ->and($first->json('data.detail_url'))->toBe('https://flowmax.test/property/'.$first->json('data.id'));
+});
+
+it('rejects the same source key with different content with 409', function (): void {
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertCreated();
+
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id, ['requested_price' => 99_000_000]))
+        ->assertStatus(409)
+        ->assertJsonPath('error.code', 'integration_key_conflict');
+
+    expect(Property::query()->count())->toBe(1);
+});
+
+it('enforces the source key at the database level', function (): void {
+    $row = [
+        'integration_user_id' => $this->integration->id,
+        'source_key' => 'lawha:response:dup',
+        'operation' => 'offer',
+        'request_hash' => str_repeat('a', 64),
+        'created_at' => now(),
+        'updated_at' => now(),
+    ];
+    DB::table('integration_intakes')->insert($row);
+
+    expect(fn () => DB::table('integration_intakes')->insert($row))->toThrow(QueryException::class);
+});
+
+it('keeps the existing property validation rules', function (): void {
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id, ['developer_id' => 999_999]))
+        ->assertStatus(422)
+        ->assertJsonPath('error.code', 'validation_error');
+
+    expect(IntegrationIntake::query()->count())->toBe(0);
+});
+
+it('attaches each media file once per media key, including after a lost response', function (): void {
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertCreated();
+    $image = UploadedFile::fake()->image('front.jpg', 800, 600);
+    $request = fn ($file, string $key, string $kind = 'image') => $this->actingAs($this->integration)->post(
+        '/api/admin/integrations/forms/offers/lawha:response:0001/media',
+        ['media_key' => $key, 'kind' => $kind, 'file' => $file],
+        ['Accept' => 'application/json'],
+    );
+
+    $request($image, 'lawha:response:0001:file:img-1')->assertCreated()->assertJsonPath('data.replayed', false);
+    $request($image, 'lawha:response:0001:file:img-1')->assertOk()->assertJsonPath('data.replayed', true);
+    $request(UploadedFile::fake()->image('other.jpg', 640, 480), 'lawha:response:0001:file:img-1')
+        ->assertStatus(409)
+        ->assertJsonPath('error.code', 'integration_key_conflict');
+    $video = UploadedFile::fake()->create('tour.mp4', 512, 'video/mp4');
+    $request($video, 'lawha:response:0001:file:vid-1', 'video')->assertCreated();
+    $request($video, 'lawha:response:0001:file:vid-1', 'video')->assertOk();
+
+    expect(PropertyImage::query()->count())->toBe(1)
+        ->and(PropertyVideo::query()->count())->toBe(1);
+
+    $this->actingAs($this->integration)->getJson('/api/admin/integrations/forms/records/lawha:response:0001')
+        ->assertOk()
+        ->assertJsonPath('data.images_count', 1)
+        ->assertJsonPath('data.videos_count', 1);
+});
+
+it('rejects media Flowmax does not accept instead of storing it', function (): void {
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertCreated();
+
+    $this->actingAs($this->integration)->post(
+        '/api/admin/integrations/forms/offers/lawha:response:0001/media',
+        ['media_key' => 'lawha:response:0001:file:doc', 'kind' => 'image', 'file' => UploadedFile::fake()->create('deed.pdf', 50, 'application/pdf')],
+        ['Accept' => 'application/json'],
+    )->assertStatus(422);
+
+    expect(PropertyImage::query()->count())->toBe(0)
+        ->and(IntegrationIntake::query()->where('source_key', 'lawha:response:0001:file:doc')->exists())->toBeFalse();
+});
+
+it('publishes only through the standard publication rules and reports public visibility', function (): void {
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertCreated();
+
+    // No image yet: publication requirements are not met, record stays a draft.
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers/lawha:response:0001/publish')
+        ->assertStatus(422);
+    $this->actingAs($this->integration)->getJson('/api/admin/integrations/forms/records/lawha:response:0001')
+        ->assertJsonPath('data.status', 'Draft')
+        ->assertJsonPath('data.is_public', false);
+
+    $this->actingAs($this->integration)->post(
+        '/api/admin/integrations/forms/offers/lawha:response:0001/media',
+        ['media_key' => 'lawha:response:0001:file:img-1', 'kind' => 'image', 'file' => UploadedFile::fake()->image('front.jpg', 800, 600)],
+        ['Accept' => 'application/json'],
+    )->assertCreated();
+
+    $published = $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers/lawha:response:0001/publish')
+        ->assertOk()
+        ->assertJsonPath('data.status', 'Published')
+        ->assertJsonPath('data.is_public', true);
+    $this->getJson('/api/public/properties/'.$published->json('data.id'))->assertOk();
+
+    // Publishing again is a no-op.
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers/lawha:response:0001/publish')
+        ->assertOk()
+        ->assertJsonPath('data.status', 'Published');
+});
+
+it('creates one demand per source key with its own detail URL and no contact data in the response', function (): void {
+    $first = $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/demands', formsDemandPayload())
+        ->assertCreated()
+        ->assertJsonPath('data.operation', 'demand')
+        ->assertJsonPath('data.status', 'under_review')
+        ->assertJsonPath('data.is_public', false);
+    $reference = $first->json('data.reference');
+
+    expect($first->json('data.detail_url'))->toBe('https://flowmax.test/properties/demands/'.$reference)
+        ->and(json_encode($first->json()))->not->toContain('551234567')
+        ->and(json_encode($first->json(), JSON_UNESCAPED_UNICODE))->not->toContain('سارة');
+
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/demands', formsDemandPayload())
+        ->assertOk()
+        ->assertJsonPath('data.reference', $reference);
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/demands', formsDemandPayload(['budget_max_halalas' => 7_000_000]))
+        ->assertStatus(409);
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/demands', formsDemandPayload(['source_key' => 'lawha:response:demand-0002', 'idempotency_key' => 'caller-supplied-key-0001']))
+        ->assertStatus(422);
+
+    expect(PropertyDemand::query()->count())->toBe(1);
+});
+
+it('does not return owner contact data in the offer record', function (): void {
+    $response = $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertCreated();
+
+    expect(json_encode($response->json(), JSON_UNESCAPED_UNICODE))
+        ->not->toContain('551234567')
+        ->not->toContain('سارة');
+});
+
+it('limits the integration account and isolates its records', function (): void {
+    $propertiesOnly = User::factory()->create(['role' => 'admin', 'status' => 'active', 'admin_permissions' => ['properties.manage']]);
+    $this->actingAs($propertiesOnly)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
+        ->assertForbidden();
+
+    // The integration account cannot use the general admin property endpoints.
+    $this->actingAs($this->integration)->getJson('/api/admin/properties')->assertForbidden();
+
+    $this->actingAs($this->integration)
+        ->postJson('/api/admin/integrations/forms/offers', formsOfferPayload($this->developer->id))
