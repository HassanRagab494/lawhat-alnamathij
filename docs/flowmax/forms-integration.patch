diff --git a/backend/tests/Feature/FormsIntegration/FormsIntegrationConcurrencyTest.php b/backend/tests/Feature/FormsIntegration/FormsIntegrationConcurrencyTest.php
new file mode 100644
index 0000000..2cfb4f9
--- /dev/null
+++ b/backend/tests/Feature/FormsIntegration/FormsIntegrationConcurrencyTest.php
@@ -0,0 +1,60 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Developer;
+use App\Models\IntegrationIntake;
+use App\Models\Property;
+use App\Models\User;
+use Illuminate\Support\Facades\Artisan;
+
+/*
+ * Real concurrency needs a database with row locks: run with
+ * DB_CONNECTION=mysql and DB_URL pointing to a dedicated test database.
+ * Skipped on the default in-memory SQLite connection. Only the migrations an
+ * offer needs are applied (the property-demand marketplace migrations are not).
+ */
+beforeEach(function (): void {
+    if (config('database.default') !== 'mysql') {
+        return;
+    }
+    $paths = collect(glob(database_path('migrations/*.php')))
+        ->reject(fn (string $path) => preg_match('/demand|candidate_supply|withdrawal_and_wallet/', basename($path)) === 1)
+        ->values()
+        ->all();
+    Artisan::call('migrate:fresh', ['--path' => $paths, '--realpath' => true, '--force' => true]);
+});
+
+it('creates exactly one property when parallel processes claim the same source key', function (): void {
+    $user = User::factory()->create(['role' => 'admin', 'status' => 'active', 'admin_permissions' => ['integrations.forms']]);
+    $developer = Developer::factory()->create();
+    $startAt = (string) (microtime(true) + 3);
+    $script = base_path('tests/Fixtures/forms-integration-claim.php');
+
+    $processes = [];
+    for ($i = 0; $i < 6; $i++) {
+        $pipes = [];
+        $process = proc_open(
+            [PHP_BINARY, $script, (string) $user->id, (string) $developer->id, 'lawha:response:concurrent', $startAt],
+            [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
+            $pipes,
+            base_path(),
+        );
+        $processes[] = [$process, $pipes];
+    }
+
+    $results = [];
+    foreach ($processes as [$process, $pipes]) {
+        $out = stream_get_contents($pipes[1]);
+        $err = stream_get_contents($pipes[2]);
+        proc_close($process);
+        $results[] = json_decode((string) $out, true) ?? ['error' => trim($out.' '.$err)];
+    }
+
+    $errors = array_filter($results, fn (array $r) => isset($r['error']));
+    expect($errors)->toBe([])
+        ->and(array_unique(array_column($results, 'id')))->toHaveCount(1)
+        ->and(array_filter($results, fn (array $r) => $r['replayed'] === false))->toHaveCount(1)
+        ->and(Property::query()->count())->toBe(1)
+        ->and(IntegrationIntake::query()->count())->toBe(1);
+})->skip(fn () => config('database.default') !== 'mysql', 'requires MySQL row locking');
