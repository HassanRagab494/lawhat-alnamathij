// مخطط المرحلة الأولى فقط: المستخدمون، الصلاحيات، الجلسات، النماذج، مسودات الإصدارات، سجل العمليات.
// جميع الأوقات تُخزَّن بتوقيت UTC (DATETIME(3)).
// المعرّفات UUIDv7: غير متسلسلة الدلالة للمستخدم الخارجي ومرتبة زمنيًا لصالح الفهارس.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
}

/// صلاحيات المشرفين. تُضاف صلاحيات مراجعة الردود والتصدير لاحقًا بـ migration تضيف قيمًا جديدة.
enum Permission {
  FORMS_VIEW
  FORMS_CREATE
  FORMS_EDIT
  FORMS_ARCHIVE
  /// نشر إصدار ثابت من المسودة (المرحلة الثالثة)
  FORMS_PUBLISH
  /// فتح استقبال الردود وإغلاقه
  FORMS_INTAKE
}

model User {
  id                String    @id @default(uuid(7)) @db.Char(36)
  /// يُخزَّن بأحرف صغيرة بعد التطبيع، وهو فريد.
  username          String    @unique @db.VarChar(32)
  displayName       String    @map("display_name") @db.VarChar(100)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole
  isActive          Boolean   @default(true) @map("is_active")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.DateTime(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.DateTime(3)
  createdById       String?   @map("created_by_id") @db.Char(36)
  /// حذف ناعم: الحساب يختفي من القوائم ويُمنع دخوله، ويبقى سجله مرتبطًا بالنماذج وسجل العمليات.
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  deletedById       String?   @map("deleted_by_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy          User?            @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]           @relation("UserCreatedBy")
  deletedBy          User?            @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers       User[]           @relation("UserDeletedBy")
  permissions        UserPermission[] @relation("PermissionHolder")
  grantedPermissions UserPermission[] @relation("PermissionGrantor")
  sessions           Session[]
  createdForms       Form[]           @relation("FormCreatedBy")
  publishedVersions  FormVersion[]    @relation("VersionPublishedBy")
  archivedForms      Form[]           @relation("FormArchivedBy")
  draftUpdates       FormDraft[]      @relation("DraftUpdatedBy")
  auditLogs          AuditLog[]

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

model UserPermission {
  userId      String     @map("user_id") @db.Char(36)
  permission  Permission
  grantedById String?    @map("granted_by_id") @db.Char(36)
  grantedAt   DateTime   @default(now()) @map("granted_at") @db.DateTime(3)

  user      User  @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permission])
  @@map("user_permissions")
}

/// جلسة قابلة للإلغاء. لا يُخزَّن الرمز نفسه؛ فقط تجزئة SHA-256 له ولرمز CSRF.
model Session {
  id            String    @id @default(uuid(7)) @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  /// logout | password_changed | password_reset | user_deactivated
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// السجل المستقل للنموذج. لا يحمل محتوى؛ المحتوى القابل للتعديل في FormDraft،
/// والإصدارات المنشورة الثابتة ستُضاف لاحقًا كجدول مستقل مرتبط بـ Form.
model Form {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  createdById        String    @map("created_by_id") @db.Char(36)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  archivedAt         DateTime? @map("archived_at") @db.DateTime(3)
  archivedById       String?   @map("archived_by_id") @db.Char(36)
  /// معرّف عام عشوائي للرابط /f/<publicId>؛ يُنشأ عند أول نشر ولا يتغير.
  publicId           String?   @unique @map("public_id") @db.VarChar(32)
  /// حالة استقبال الردود، مستقلة عن النشر. الأرشفة تغلقها والاستعادة لا تعيد فتحها.
  acceptingResponses Boolean   @default(false) @map("accepting_responses")

  createdBy  User           @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedBy User?          @relation("FormArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  draft      FormDraft?
  versions   FormVersion[]
  responses  FormResponse[]

  @@index([archivedAt, updatedAt])
  @@map("forms")
}

/// مسودة الإصدار الحالية للنموذج (واحدة لكل نموذج). revision يزيد مع كل حفظ لمنع الكتابة فوق تعديل متزامن.
model FormDraft {
  id          String   @id @default(uuid(7)) @db.Char(36)
  formId      String   @unique @map("form_id") @db.Char(36)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  revision    Int      @default(1)
  updatedById String   @map("updated_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  form      Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  updatedBy User                @relation("DraftUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions FormDraftQuestion[]

  @@index([title])
  @@map("form_drafts")
}

/// أنواع أسئلة المرحلة الثانية. FILE_UPLOAD إعداد ومعاينة فقط دون رفع فعلي.
enum QuestionType {
  SHORT_TEXT
  PARAGRAPH
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  NUMBER
  DATE
  FILE_UPLOAD
}

/// سؤال في مسودة النموذج. المعرّف ثابت عبر الحفظ؛ الترتيب في position فقط.
/// settings: إعدادات خاصة بالنوع، يتحقق منها الخادم بمخطط صارم قبل الحفظ (forms/questions/draft-schema.ts).
model FormDraftQuestion {
  id          String       @id @default(uuid(7)) @db.Char(36)
  draftId     String       @map("draft_id") @db.Char(36)
  position    Int
  type        QuestionType
  title       String       @db.VarChar(300)
  description String?      @db.Text
  required    Boolean      @default(false)
  settings    Json
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  draft   FormDraft                 @relation(fields: [draftId], references: [id], onDelete: Cascade)
  options FormDraftQuestionOption[]

  @@index([draftId, position])
  @@map("form_draft_questions")
}

/// خيار لسؤال من أنواع الاختيار. المعرّف ثابت عبر الحفظ؛ الترتيب في position فقط.
model FormDraftQuestionOption {
  id         String   @id @default(uuid(7)) @db.Char(36)
  questionId String   @map("question_id") @db.Char(36)
  position   Int
  label      String   @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  question FormDraftQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("form_draft_question_options")
}

/// سجل العمليات الإدارية. لا يُخزَّن فيه أي كلمة مرور أو رمز جلسة.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.Char(36)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// إصدار منشور ثابت: نسخة كاملة من المسودة وقت النشر، لا يعتمد على سجلات المسودة.
model FormVersion {
  id                  String   @id @default(uuid(7)) @db.Char(36)
  formId              String   @map("form_id") @db.Char(36)
  versionNumber       Int      @map("version_number")
  title               String   @db.VarChar(200)
  description         String?  @db.Text
  /// revision المسودة التي نُشرت؛ اختلافه عن revision الحالي يعني وجود تعديلات غير منشورة.
  sourceDraftRevision Int      @map("source_draft_revision")
  /// مفتاح إعادة محاولة النشر (من العميل)؛ إعادة الطلب نفسه تعيد الإصدار نفسه.
  publishKey          String   @map("publish_key") @db.Char(36)
  publishedById       String   @map("published_by_id") @db.Char(36)
  publishedAt         DateTime @default(now()) @map("published_at") @db.DateTime(3)

  form        Form                  @relation(fields: [formId], references: [id], onDelete: Restrict)
  publishedBy User                  @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  questions   FormVersionQuestion[]
  responses   FormResponse[]

  @@unique([formId, versionNumber])
  @@unique([formId, publishKey])
  @@map("form_versions")
}

model FormVersionQuestion {
  id          String       @id @default(uuid(7)) @db.Char(36)
  versionId   String       @map("version_id") @db.Char(36)
  /// معرّف السؤال المنطقي عبر الإصدارات (معرّف سؤال المسودة وقت النشر)؛ ليس مفتاحًا أجنبيًا.
  logicalId   String       @map("logical_id") @db.Char(36)
  position    Int
  type        QuestionType
  title       String       @db.VarChar(300)
  description String?      @db.Text
  required    Boolean
  settings    Json

  version FormVersion         @relation(fields: [versionId], references: [id], onDelete: Restrict)
  options FormVersionOption[]
  answers FormAnswer[]

  @@unique([versionId, logicalId])
  @@index([versionId, position])
  @@map("form_version_questions")
}

model FormVersionOption {
  id         String @id @default(uuid(7)) @db.Char(36)
  questionId String @map("question_id") @db.Char(36)
  logicalId  String @map("logical_id") @db.Char(36)
  position   Int
  label      String @db.VarChar(200)

  question FormVersionQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selected FormAnswerOption[]

  @@index([questionId, position])
  @@map("form_version_options")
}

enum ResponseStatus {
  NEW
}

/// رد زائر على إصدار منشور. لا يُخزَّن IP أو User-Agent.
model FormResponse {
  id             String         @id @default(uuid(7)) @db.Char(36)
  formId         String         @map("form_id") @db.Char(36)
  versionId      String         @map("version_id") @db.Char(36)
  /// رقم مرجعي عشوائي غير متسلسل يُعرض للزائر؛ لا يمنح أي حق قراءة.
  referenceCode  String         @unique @map("reference_code") @db.VarChar(16)
  status         ResponseStatus @default(NEW)
  /// مفتاح إعادة المحاولة من العميل؛ فريد لكل نموذج، فإعادة الطلب نفسه تعيد الرد الأصلي.
  idempotencyKey String         @map("idempotency_key") @db.Char(36)
  /// SHA-256 لمحتوى الطلب المطبّع (الإصدار والإجابات) لكشف إعادة استخدام المفتاح بمحتوى مختلف.
  requestHash    String         @map("request_hash") @db.Char(64)
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.DateTime(3)

  form    Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  version FormVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  answers FormAnswer[]

  @@unique([formId, idempotencyKey])
  @@index([formId, submittedAt])
  @@map("form_responses")
}

/// إجابة سؤال واحد. العمود المستخدم حسب نوع السؤال: نص، رقم عشري، تاريخ، أو خيارات في form_answer_options.
model FormAnswer {
  id          String    @id @default(uuid(7)) @db.Char(36)
  responseId  String    @map("response_id") @db.Char(36)
  questionId  String    @map("question_id") @db.Char(36)
  textValue   String?   @map("text_value") @db.Text
  numberValue Decimal?  @map("number_value") @db.Decimal(23, 10)
  dateValue   DateTime? @map("date_value") @db.Date

  response FormResponse        @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question FormVersionQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  options  FormAnswerOption[]

  @@unique([responseId, questionId])
  @@map("form_answers")
}

model FormAnswerOption {
  answerId String @map("answer_id") @db.Char(36)
  optionId String @map("option_id") @db.Char(36)

  answer FormAnswer        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option FormVersionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@map("form_answer_options")
}
