# انسخ هذا الملف إلى .env ثم غيّر القيم. لا تضع أسرارًا حقيقية في Git.

# ---- اسم المنصة (إعداد مركزي تقرؤه الواجهة والـ API) ----
APP_NAME="لوحة النماذج"

# ---- MySQL عبر Docker Compose ----
MYSQL_DATABASE=lawha
MYSQL_USER=lawha
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_PORT=3306
# حساب مستقل لقاعدة الاختبار فقط (لا صلاحية له على القاعدة الأساسية)
MYSQL_TEST_USER=lawha_tester
MYSQL_TEST_PASSWORD=change-me-test-local-only

# ---- الـ API (NestJS) ----
DATABASE_URL="mysql://lawha:change-me-local-only@localhost:3306/lawha"
# قاعدة مؤقتة يحتاجها `prisma migrate dev` فقط عند إنشاء migration جديدة
SHADOW_DATABASE_URL="mysql://lawha:change-me-local-only@localhost:3306/lawha_shadow"
# قاعدة مستقلة لاختبارات التكامل (تُمسح بالكامل قبل كل تشغيل)
TEST_DATABASE_URL="mysql://lawha_tester:change-me-test-local-only@localhost:3306/lawha_test"
# لا توافق إلا بعد مراجعة الهدف: اضبطها يدويًا إلى lawha_test لتسمح بمسحها
ALLOW_TEST_DATABASE_RESET=
API_PORT=4000
# أصل الواجهة المسموح له بإرسال الطلبات (فحص Origin + CORS)
WEB_ORIGIN=http://localhost:3000
# true في أي بيئة تعمل عبر HTTPS
COOKIE_SECURE=false
# العمر الأقصى للجلسة بالساعات، ومدة الخمول قبل انتهائها بالدقائق
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# إيقاف الدخول مؤقتًا بعد عدد محاولات فاشلة متتالية
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# حد طلبات الدخول في الدقيقة لكل عنوان IP
LOGIN_RATE_LIMIT_PER_MINUTE=10
# حدود إرسال الردود العامة في الدقيقة: لكل عنوان IP، ولكل نموذج (سقف لا يتأثر بالترويسات)
PUBLIC_SUBMIT_PER_IP_PER_MINUTE=10
PUBLIC_SUBMIT_PER_FORM_PER_MINUTE=120
# حدود مسارات إدارة الردود لكل مستخدم في الدقيقة: القائمة والتفاصيل وتغيير الحالة، والتصدير CSV
RESPONSES_RATE_LIMIT_PER_MINUTE=120
RESPONSES_EXPORT_PER_MINUTE=5
# رفع الملفات: التخزين، والفاحص (غيابه يعطّل الرفع؛ لا يُقبل ملف دون فحص)، والحدود
UPLOAD_DIR=./.tmp/uploads
# UPLOAD_SCAN_MODE=required   # disabled: قبول الملفات بعد التحقق من النوع والحجم دون فحص برمجيات خبيثة
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=60000
# UPLOAD_SESSION_TTL_MINUTES=240
# UPLOAD_SESSION_MAX_MB=100
# UPLOAD_STORAGE_MAX_GB=20
# PUBLIC_UPLOAD_PER_IP_PER_MINUTE=30
# PUBLIC_UPLOAD_PER_FORM_PER_MINUTE=300
# من يُوثق بترويسة X-Forwarded-For منه (قيمة Express "trust proxy"): عنوان الواجهة Next.js أو شبكتها الداخلية فقط.
# loopback محليًا. في الإنتاج يجب ضبطه صراحة؛ تُرفض true و false و* والشبكات الشاملة وعدد القفزات.
# Next.js يمرر الترويسة كما أرسلها الزائر: انظر docs/trust-boundary.md (وكيل أمامي يستبدلها، ولا منافذ عامة للواجهة والـ API).
TRUST_PROXY=loopback
# وثائق /api/docs: مفعّلة افتراضيًا في التطوير، ومعطّلة افتراضيًا في الإنتاج (NODE_ENV=production)
# API_DOCS_ENABLED=true

# ---- الواجهة (Next.js) ----
# عنوان الـ API الذي تمرر إليه الواجهة طلبات /api/*
API_ORIGIN=http://localhost:4000
