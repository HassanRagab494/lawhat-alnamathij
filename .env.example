# انسخ هذا الملف إلى .env ثم غيّر القيم. لا تضع أسرارًا حقيقية في Git.

# ---- اسم المنصة (إعداد مركزي تقرؤه الواجهة والـ API) ----
APP_NAME="لوحة النماذج"

# ---- MySQL عبر Docker Compose ----
MYSQL_DATABASE=lawha
MYSQL_USER=lawha
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_PORT=3306
# حساب مستقل لقاعدة الاختبار فقط (لا صلاحية له على القاعدة الأساسية)
MYSQL_TEST_USER=lawha_tester
MYSQL_TEST_PASSWORD=change-me-test-local-only

# ---- الـ API (NestJS) ----
DATABASE_URL="mysql://lawha:change-me-local-only@localhost:3306/lawha"
# قاعدة مؤقتة يحتاجها `prisma migrate dev` فقط عند إنشاء migration جديدة
SHADOW_DATABASE_URL="mysql://lawha:change-me-local-only@localhost:3306/lawha_shadow"
# قاعدة مستقلة لاختبارات التكامل (تُمسح بالكامل قبل كل تشغيل)
TEST_DATABASE_URL="mysql://lawha_tester:change-me-test-local-only@localhost:3306/lawha_test"
# لا توافق إلا بعد مراجعة الهدف: اضبطها يدويًا إلى lawha_test لتسمح بمسحها
ALLOW_TEST_DATABASE_RESET=
API_PORT=4000
# أصل الواجهة المسموح له بإرسال الطلبات (فحص Origin + CORS)
WEB_ORIGIN=http://localhost:3000
# true في أي بيئة تعمل عبر HTTPS
COOKIE_SECURE=false
# العمر الأقصى للجلسة بالساعات، ومدة الخمول قبل انتهائها بالدقائق
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# إيقاف الدخول مؤقتًا بعد عدد محاولات فاشلة متتالية
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# حد طلبات الدخول في الدقيقة لكل عنوان IP
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---- الواجهة (Next.js) ----
# عنوان الـ API الذي تمرر إليه الواجهة طلبات /api/*
API_ORIGIN=http://localhost:4000
