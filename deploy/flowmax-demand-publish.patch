+it('publishes a reviewed forms demand once and keeps it scoped to its integration account', function (): void {
+    $payload = formsDemandPayload();
+    $first = $this->actingAs($this->integration)->postJson('/api/admin/integrations/forms/demands', $payload)->assertCreated();
+    $url = '/api/admin/integrations/forms/demands/'.$payload['source_key'].'/publish';
+    $this->actingAs(formsIntegrationUser())->postJson($url)->assertNotFound();
+    $this->actingAs($this->integration)->postJson($url)->assertOk()
+        ->assertJsonPath('data.id', $first->json('data.id'))
+        ->assertJsonPath('data.status', 'published')->assertJsonPath('data.is_public', true);
+    $this->actingAs($this->integration)->postJson($url)->assertOk()->assertJsonPath('data.is_public', true);
+    expect(PropertyDemand::query()->count())->toBe(1);
+});
