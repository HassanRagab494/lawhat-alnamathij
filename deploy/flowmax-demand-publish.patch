+    /** Publish only a demand belonging to this integration account, after forms review. */
+    public function publishDemand(User $actor, IntegrationIntake $intake): PropertyDemand
+    {
+        if ($intake->operation !== self::DEMAND || (int) $intake->integration_user_id !== (int) $actor->id) {
+            throw new FlowmaxRuleException('integration_record_not_demand', 'The source record is not a demand owned by this integration account.', 422);
+        }
+
+        return DB::transaction(function () use ($actor, $intake): PropertyDemand {
+            $demand = PropertyDemand::query()->lockForUpdate()->findOrFail($intake->target_id);
+            if (in_array($demand->status, ['published', 'matching'], true)) {
+                return $demand;
+            }
+            $reason = 'Reviewed and approved in forms platform';
+            if (in_array($demand->status, ['submitted', 'under_review'], true)) {
+                $demand = $this->demandAdmin->transition($demand, 'approve', $reason, $actor->id);
+            }
+
+            return $this->demandAdmin->transition($demand, 'publish', $reason, $actor->id);
+        }, self::CLAIM_ATTEMPTS);
+    }
