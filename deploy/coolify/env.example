# متغيرات Coolify لمورد lawhat-alnamathij (قالب بلا أسرار). تُضبط في واجهة Coolify، ولا يُرفع ملف بقيم حقيقية.
#
# مطلوبة — أسرار (فعّل «Is Secret»/«Lock» في Coolify):
# كلمة مستخدم القاعدة؛ تدخل في DATABASE_URL فاستخدم أحرفًا وأرقامًا فقط (32 حرفًا أو أكثر).
MYSQL_PASSWORD=
# كلمة root لـ MySQL (لا يستخدمها التطبيق؛ لفحص الصحة والإدارة فقط).
MYSQL_ROOT_PASSWORD=
#
# مطلوبة — ليست أسرارًا:
WEB_ORIGIN=https://forms.flowmaxsa.cloud
#
# اختيارية (القيم الافتراضية في compose.production.yaml):
# APP_NAME=لوحة النماذج
# شبكة backend الداخلية بين web وapi وmysql؛ TRUST_PROXY في api يساويها. غيّرها فقط إن تعارضت مع شبكة موجودة على الخادم.
# BACKEND_SUBNET=10.213.47.0/28
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# PUBLIC_SUBMIT_PER_IP_PER_MINUTE=10
# PUBLIC_SUBMIT_PER_FORM_PER_MINUTE=120
# RESPONSES_RATE_LIMIT_PER_MINUTE=120
# RESPONSES_EXPORT_PER_MINUTE=5
#
# مثبتة في compose.production.yaml عمدًا (لا تُضبط من Coolify):
# NODE_ENV=production · COOKIE_SECURE=true · API_DOCS_ENABLED=false · TRUST_PROXY=${BACKEND_SUBNET}
# API_ORIGIN=http://lawha-api-backend:4000 (build arg للواجهة) · DATABASE_URL يُبنى من MYSQL_PASSWORD
# لا تُضبط في الإنتاج: TEST_DATABASE_URL، MYSQL_TEST_*، ALLOW_TEST_DATABASE_RESET، SHADOW_DATABASE_URL، INITIAL_ADMIN_PASSWORD.
