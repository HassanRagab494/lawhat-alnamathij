# متغيرات Coolify لمورد lawhat-alnamathij (قالب بلا أسرار). تُضبط في واجهة Coolify، ولا يُرفع ملف بقيم حقيقية.
#
# أسرار (فعّل «Is Secret»/«Lock» في Coolify). MYSQL_* مطلوبة للتشغيل؛ BACKUP_* مطلوبة لتفعيل النسخ الاحتياطي
# (بدونها يعمل التطبيق، وخدمة backup تسجل «not configured» ولا تنسخ شيئًا):
# كلمة مستخدم القاعدة؛ تدخل في DATABASE_URL فاستخدم أحرفًا وأرقامًا فقط (32 حرفًا أو أكثر).
MYSQL_PASSWORD=
# كلمة root لـ MySQL (لا يستخدمها التطبيق؛ لفحص الصحة والإدارة فقط).
MYSQL_ROOT_PASSWORD=
# كلمة حساب القراءة lawha_backup (deploy/backup/create-backup-user.sql).
BACKUP_DB_PASSWORD=
# مفتاح تشفير النسخ (مثلًا openssl rand -hex 32). احفظ نسخة منه خارج الخادم؛ دونه لا استعادة.
BACKUP_ENCRYPTION_KEY=
#
# مطلوبة — ليست أسرارًا:
WEB_ORIGIN=https://forms.flowmaxsa.cloud
# الإعداد المنشور حاليًا دون خدمة ClamAV: الرفع يتحقق من النوع الفعلي والامتداد والحجم والصلاحيات والمعدل فقط،
# ولا يفحص البرمجيات الخبيثة؛ الملفات تُعلَّم «غير مفحوصة». دون هذا المتغير (أو بـ required دون CLAMAV_HOST) يبقى الرفع معطلًا.
UPLOAD_SCAN_MODE=disabled
#
# اختيارية (القيم الافتراضية في compose.production.yaml):
# APP_NAME=لوحة النماذج
# شبكة backend الداخلية؛ TRUST_PROXY في api يساويها. غيّرها فقط إن تعارضت مع شبكة موجودة على الخادم.
# BACKEND_SUBNET=10.213.47.0/28
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# PUBLIC_SUBMIT_PER_IP_PER_MINUTE=10
# PUBLIC_SUBMIT_PER_FORM_PER_MINUTE=120
# RESPONSES_RATE_LIMIT_PER_MINUTE=120
# RESPONSES_EXPORT_PER_MINUTE=5
# رفع الملفات:
# PUBLIC_UPLOAD_PER_IP_PER_MINUTE=30
# PUBLIC_UPLOAD_PER_FORM_PER_MINUTE=300
# UPLOAD_SESSION_TTL_MINUTES=240
# UPLOAD_SESSION_MAX_MB=300
# UPLOAD_STORAGE_MAX_GB=20
# ربط Flowmax (معطّل حتى تُضبط هذه القيم في Coolify؛ لا تُكتب في أي ملف):
# FLOWMAX_ENABLED=false  (يبقى false حتى يُنشر تحديث Flowmax في بيئته ويُختبر هناك؛ انظر docs/flowmax-integration.md)
# FLOWMAX_API_BASE_URL=   (أصل API لـ Flowmax، https)
# FLOWMAX_SERVICE_TOKEN=  (سر: Is Secret — رمز حساب تكامل مخصص، لا حساب المدير)
# FLOWMAX_DEVELOPER_ID=   (معرّف المطور الداخلي في Flowmax)
# FLOWMAX_TIMEOUT_MS=15000 · FLOWMAX_MEDIA_TIMEOUT_MS=300000
# فحص ClamAV (غير مُشغَّل حاليًا؛ انظر deploy/clamav/compose.clamav.yaml): UPLOAD_SCAN_MODE=required مع
# CLAMAV_HOST=lawha-clamav-backend وCLAMAV_TIMEOUT_MS=60000 وCLAMAV_MEM_LIMIT=2g وCLAMAV_CPUS=1.0
# النسخ الاحتياطي:
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_MEM_LIMIT=512m
# BACKUP_CPUS=0.5
#
# مثبتة في compose.production.yaml عمدًا (لا تُضبط من Coolify):
# NODE_ENV=production · COOKIE_SECURE=true · API_DOCS_ENABLED=false · TRUST_PROXY=${BACKEND_SUBNET}
# API_ORIGIN=http://lawha-api-backend:4000 (build arg للواجهة) · DATABASE_URL يُبنى من MYSQL_PASSWORD
# UPLOAD_DIR=/data/uploads · TZ=Asia/Riyadh (backup)
# لا تُضبط في الإنتاج: TEST_DATABASE_URL، MYSQL_TEST_*، ALLOW_TEST_DATABASE_RESET، SHADOW_DATABASE_URL، INITIAL_ADMIN_PASSWORD.
